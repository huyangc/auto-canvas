# Optional repository-root .env for pnpm start, pnpm stop and pnpm dev.
# Copy this file to .env and uncomment the settings you need.
# This file is sourced as Bash; quote values containing spaces or shell syntax.
# Exported shell variables take precedence, including empty values.

# Server: PostgreSQL connection URL (custom databases must already exist).
# DATABASE_URL=postgresql:///auto_canvas
# Server bind address and HTTP port.
# HOST=127.0.0.1
# PORT=4310
# Initial display name; the persisted profile takes precedence.
# AUTO_CANVAS_USER_NAME='Local user'
# Positive integer: maximum Projects for the local user.
# AUTO_CANVAS_PROJECT_LIMIT=200
# Agent session idle timeout in milliseconds.
# AUTO_CANVAS_AGENT_IDLE_MS=300000
# Allowed Agent browser origin; default: the request origin (unset).
# AGENT_ALLOWED_ORIGIN=http://127.0.0.1:4310
# Static editor directory; direct server default: unset.
# pnpm start always uses apps/editor/dist; pnpm dev always unsets it.
# EDITOR_ROOT=apps/editor/dist

# Launcher health wait and shutdown grace period, in integer seconds.
# START_TIMEOUT=60
# STOP_TIMEOUT=10
# Skip the full build in pnpm start only (1 skips; default 0 builds).
# SKIP_BUILD=0
# PostgreSQL CLI connection timeout in seconds (set by the launchers).
# PGCONNECT_TIMEOUT=5
# Vite API proxy; pnpm dev defaults to the configured server URL.
# Editor-only dev/preview default: http://127.0.0.1:4310.
# AUTO_CANVAS_API_URL=http://127.0.0.1:4310
# Test database; tests run directly do not load this .env via the launchers.
# AUTO_CANVAS_TEST_DATABASE_URL=postgresql:///auto_canvas_test
