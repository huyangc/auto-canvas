{
  "name": "analog-canvas",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.16.0"
  },
  "dependencies": {
    "@icm/agent-adapter": "workspace:*",
    "@icm/derived": "workspace:*",
    "@icm/devices": "workspace:*",
    "@icm/model": "workspace:*",
    "@icm/netlist": "workspace:*",
    "@icm/project-protocol": "workspace:*",
    "@icm/render-svg": "workspace:*",
    "@icm/symbols": "workspace:*",
    "@icm/component-library": "workspace:*"
  },
  "scripts": {
    "rnl:package:check": "node scripts/rnl-canvas-package.mjs --check",
    "rnl:package:fetch": "node scripts/rnl-canvas-package.mjs --fetch",
    "build": "pnpm -r --if-present build",
    "performance:check": "pnpm build && node scripts/performance-baseline.mjs",
    "export:golden": "pnpm build && node scripts/export-golden.mjs",
    "export:golden:check": "pnpm build && node scripts/export-golden.mjs --check",
    "pwa:icons": "pnpm --filter @icm/exporters build && node scripts/pwa-icons.mjs",
    "pwa:icons:check": "pnpm --filter @icm/exporters build && node scripts/pwa-icons.mjs --check",
    "agent-api:artifacts": "pnpm --filter @icm/agent-adapter... build && node scripts/agent-api-artifacts.mjs",
    "agent-api:artifacts:check": "pnpm --filter @icm/agent-adapter... build && node scripts/agent-api-artifacts.mjs --check",
    "agent-kit:catalog": "node scripts/generate-agent-authoring-catalog.mjs",
    "agent-kit:catalog:check": "node scripts/generate-agent-authoring-catalog.mjs --check",
    "headless:package": "node scripts/package-headless.mjs",
    "mcp:package": "pnpm build && node scripts/package-mcp.mjs",
    "start": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "dev": "bash scripts/dev.sh",
    "dev:editor": "pnpm --filter @icm/editor dev",
    "lint": "node scripts/lint.mjs",
    "draw:batch": "node scripts/draw-batch.mjs",
    "setup:e2e": "playwright install --with-deps chromium",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "symbols:razavi": "node scripts/generate-razavi-signal-flow-assets.mjs && node scripts/generate-razavi-magnetic-components.mjs && node scripts/generate-component-library.mjs && node scripts/generate-razavi-symbol-catalog.mjs && node scripts/generate-agent-authoring-catalog.mjs && node scripts/generate-agent-docs.mjs",
    "symbols:razavi:check": "node scripts/generate-razavi-signal-flow-assets.mjs --check && node scripts/generate-razavi-magnetic-components.mjs --check && node scripts/generate-component-library.mjs --check && node scripts/generate-razavi-symbol-catalog.mjs --check && node scripts/generate-agent-authoring-catalog.mjs --check && node scripts/generate-agent-docs.mjs --check",
    "symbols:razavi-mos": "node scripts/generate-razavi-mos-assets.mjs",
    "symbols:razavi-mos:check": "node scripts/generate-razavi-mos-assets.mjs --check",
    "symbols:razavi-peripherals": "node scripts/generate-razavi-peripheral-assets.mjs",
    "symbols:razavi-peripherals:check": "node scripts/generate-razavi-peripheral-assets.mjs --check",
    "symbols:razavi-inductor": "node scripts/generate-razavi-inductor-asset.mjs",
    "symbols:razavi-inductor:check": "node scripts/generate-razavi-inductor-asset.mjs --check",
    "symbols:razavi-magnetic": "node scripts/generate-razavi-magnetic-components.mjs",
    "symbols:razavi-magnetic:check": "node scripts/generate-razavi-magnetic-components.mjs --check",
    "symbols:razavi-opamp": "node scripts/generate-razavi-opamp-asset.mjs",
    "symbols:razavi-opamp:check": "node scripts/generate-razavi-opamp-asset.mjs --check",
    "symbols:converters": "node scripts/generate-converter-assets.mjs",
    "symbols:converters:check": "node scripts/generate-converter-assets.mjs --check",
    "symbols:lettered-amps": "node scripts/generate-lettered-amplifiers.mjs",
    "symbols:lettered-amps:check": "node scripts/generate-lettered-amplifiers.mjs --check",
    "symbols:swap-inputs": "node scripts/generate-input-swapped-amplifiers.mjs",
    "symbols:swap-inputs:check": "node scripts/generate-input-swapped-amplifiers.mjs --check",
    "symbols:razavi-logic": "node scripts/generate-razavi-logic-gate-assets.mjs",
    "symbols:razavi-logic:check": "node scripts/generate-razavi-logic-gate-assets.mjs --check",
    "symbols:razavi-buffer-dff": "node scripts/generate-razavi-buffer-dff-assets.mjs",
    "symbols:razavi-buffer-dff:check": "node scripts/generate-razavi-buffer-dff-assets.mjs --check",
    "symbols:razavi-delay-cell": "node scripts/generate-razavi-delay-cell-asset.mjs",
    "symbols:razavi-delay-cell:check": "node scripts/generate-razavi-delay-cell-asset.mjs --check",
    "symbols:razavi-common": "node scripts/generate-razavi-common-assets.mjs",
    "symbols:razavi-common:check": "node scripts/generate-razavi-common-assets.mjs --check",
    "symbols:razavi-zener": "node scripts/generate-razavi-zener-asset.mjs",
    "symbols:razavi-zener:check": "node scripts/generate-razavi-zener-asset.mjs --check",
    "symbols:razavi-battery": "node scripts/generate-razavi-battery-asset.mjs",
    "symbols:razavi-battery:check": "node scripts/generate-razavi-battery-asset.mjs --check",
    "auto-layout:recognition": "node scripts/auto-layout-recognition.mjs",
    "auto-layout:eval": "node scripts/auto-layout-eval.mjs",
    "auto-layout:review": "pnpm build && node scripts/auto-layout-review.mjs",
    "visual:golden": "pnpm build && node scripts/visual-golden.mjs",
    "visual:golden:check": "pnpm build && node scripts/visual-golden.mjs --check",
    "test": "vitest run",
    "test:local": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:local": "pnpm --filter \"@icm/editor^...\" --filter \"@icm/mcp-server...\" --if-present build && playwright test",
    "build:e2e": "node scripts/build-e2e-editor.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "deadcode": "knip --no-progress && knip --production --no-progress",
    "symbols:razavi-signal-flow": "node scripts/generate-razavi-signal-flow-assets.mjs",
    "symbols:razavi-signal-flow:check": "node scripts/generate-razavi-signal-flow-assets.mjs --check",
    "components:generate": "node scripts/generate-component-library.mjs && node scripts/generate-razavi-symbol-catalog.mjs && node scripts/generate-agent-authoring-catalog.mjs",
    "components:check": "node scripts/generate-component-library.mjs --check && node scripts/generate-razavi-symbol-catalog.mjs --check",
    "agent-docs:generate": "node scripts/generate-agent-docs.mjs",
    "agent-docs:generated:check": "node scripts/generate-agent-docs.mjs --check",
    "agent-docs:check": "pnpm agent-docs:generated:check && pnpm test:local scripts/generate-agent-docs.test.mjs",
    "test:editor-build": "pnpm --filter @icm/editor... --if-present build && pnpm test:desktop-build",
    "test:desktop-build": "pnpm --filter @icm/editor exec vite build --config vite.desktop.config.ts",
    "check": "pnpm format:check && pnpm docs:check && pnpm agent-docs:generated:check && pnpm components:check && pnpm typecheck && pnpm lint && pnpm test:local && pnpm build",
    "server:dev": "pnpm --filter @icm/server... build && node apps/server/dist/cli.js",
    "server:migrate": "pnpm --filter @icm/server... build && node apps/server/dist/cli.js --migrate"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "knip": "6.40.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "pngjs": "^7.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
