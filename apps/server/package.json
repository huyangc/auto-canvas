{
  "name": "@icm/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "auto-canvas-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "@icm/derived": "workspace:*",
    "@icm/model": "workspace:*",
    "@icm/project-protocol": "workspace:*",
    "@icm/render-svg": "workspace:*",
    "@icm/symbols": "workspace:*",
    "@icm/component-library": "workspace:*",
    "@icm/agent-adapter": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
